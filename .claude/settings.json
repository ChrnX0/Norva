  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$NORVA_INSIGHTS_CHILD\" ] || NORVA_INSIGHTS_CHILD=1 claude -p '/insights' >> \"$HOME/.claude/insights-auto.log\" 2>&1 &"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .proofgate/hooks/push-guard.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/sem-espera.sh"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
