{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",

      "Read", "Edit", "MultiEdit", "Write", "NotebookEdit",
      "Glob", "Grep", "WebFetch", "WebSearch",
      "Task", "TodoWrite", "TaskCreate", "TaskUpdate", "TaskList", "TaskGet",
      "TaskOutput", "TaskStop", "Skill", "ListSkills", "SearchSkills",
      "SendUserFile", "PushNotification", "SendMessage", "Monitor",
      "ScheduleWakeup", "CronCreate", "CronList", "CronDelete",
      "ListMcpResourcesTool", "ReadMcpResourceTool", "ListConnectors",

