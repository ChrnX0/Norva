{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "MultiEdit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "TodoWrite",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskOutput",
      "TaskStop",
      "Skill",
      "ListSkills",
      "SearchSkills",
      "SendUserFile",
      "PushNotification",
      "SendMessage",
      "Monitor",
      "ScheduleWakeup",
      "CronCreate",
      "CronList",
      "CronDelete",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ListConnectors",
      "mcp__github",
      "mcp__GitHub",
      "mcp__Vercel",
      "mcp__Expo",
      "mcp__Supabase",
      "mcp__Claude_Code_Remote",
      "mcp__Figma",
      "mcp__GoDaddy"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$NORVA_INSIGHTS_CHILD\" ] || NORVA_INSIGHTS_CHILD=1 claude -p '/insights' >> \"$HOME/.claude/insights-auto.log\" 2>&1 &"
          }
        ]
      }
    ]
  }
}
