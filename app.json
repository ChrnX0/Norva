{
  "expo": {
    "name": "NORVA",
    "slug": "norva",
    "scheme": "norva",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.norva.mobile"
    },
    "android": {
      "package": "app.norva.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F7F6F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "chrnx0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/384e9ec9-b731-4691-a622-d1edc89259a1",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "384e9ec9-b731-4691-a622-d1edc89259a1"
      }
    }
  }
}
