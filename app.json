{
  "expo": {
    "name": "NORVA",
    "slug": "norva",
    "scheme": "norva",
    "version": "0.12.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.norva.mobile"
    },
    "android": {
      "package": "app.norva.mobile",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera lê a etiqueta do lote. Nada é fotografado nem guardado.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1B1610",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "chrnx0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/384e9ec9-b731-4691-a622-d1edc89259a1",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "384e9ec9-b731-4691-a622-d1edc89259a1"
      },
      "supabaseUrl": "https://xnefmqphczgcujzdaere.supabase.co",
      "supabaseKey": "sb_publishable_vsSW8w4iETpERn3AUZfWnw_g0oLispj"
    }
  }
}
